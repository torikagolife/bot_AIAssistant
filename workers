function buildSelectorFlex(currentId) {
  const buttons = EXPERTS.map((e) => {
    const isCurrent = e.id === currentId;
    const btn = {
      type: "button",
      style: isCurrent ? "secondary" : "primary",
      height: "sm",
      action: {
        type: "message",
        // 表示は絵文字付き、送信テキストは名前のみ（判定用）
        label: isCurrent ? `${label(e)}(選択中)` : label(e),
        text: e.name,
        postback: `select:${e.id}`,
      },
    };
    if (!isCurrent) btn.color = e.color;
    return btn;
  });

  return {
    type: "flexible",
    altText: "AIアシスタントを選んでください",
    contents: {
      type: "bubble",
      header: {
        type: "box",
        layout: "vertical",
        contents: [
          {
            type: "text",
            text: "AIアシスタントを選んでください",
            weight: "bold",
            size: "lg",
            wrap: true,
          },
          {
            type: "text",
            text: "タップすると、そのアシスタントと会話できます",
            size: "xs",
            color: "#888888",
            wrap: true,
          },
        ],
      },
      body: {
        type: "box",
        layout: "vertical",
        spacing: "sm",
        contents: buttons,
      },
      footer: {
        type: "box",
        layout: "vertical",
        contents: [
          {
            type: "text",
            text: "※AIの回答は参考情報です。判断は必ず医師・薬剤師等にご確認ください。緊急時はすぐに医療機関へ。「ヘルプ」で使い方を表示します。",
