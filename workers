// 3. 汎用ユーティリティ
// ==================================================================

function bytesToB64(bytes) {
  const arr = new Uint8Array(bytes);
  let bin = "";
  const CHUNK = 0x8000;
  for (let i = 0; i < arr.length; i += CHUNK) {
    bin += String.fromCharCode.apply(null, arr.subarray(i, i + CHUNK));
  }
  return btoa(bin);
}

function b64ToBytes(b64) {
  const bin = atob(b64);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}

function b64url(input) {
  const raw =
    typeof input === "string"
      ? bytesToB64(new TextEncoder().encode(input))
      : bytesToB64(input);
  return raw.replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}

/** PEM -> ArrayBuffer（ダッシュボード貼り付けで改行が "\n" 文字列化しても対応） */
function pemToArrayBuffer(pem) {
  const body = String(pem)
    .replace(/\\n/g, "\n")
    .replace(/-----BEGIN [^-]+-----/g, "")
    .replace(/-----END [^-]+-----/g, "")
    .replace(/\s+/g, "");
  return b64ToBytes(body).buffer;
}

function safeEqual(a, b) {
  if (typeof a !== "string" || typeof b !== "string") return false;
  if (a.length !== b.length) return false;
  let diff = 0;
  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

/** 全角英数→半角、空白除去、小文字化（コマンド判定用） */
function normalize(text) {
  return String(text)
    .replace(/[Ａ-Ｚａ-ｚ０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0))
    .replace(/[\s　]/g, "")
    .toLowerCase();
}

function intEnv(value, fallback, min, max) {
  const n = parseInt(value, 10);
  if (Number.isNaN(n)) return fallback;
  return Math.min(max, Math.max(min, n));
}

/** 環境変数のテキスト取得（"\n" 文字列を改行に戻す） */
function envText(value) {
  return typeof value === "string" ? value.replace(/\\n/g, "\n").trim() : "";
}

/** UTF-8でのバイト数 */
function byteLength(value) {
  return typeof value === "string" ? new TextEncoder().encode(value).length : 0;
}

/** 秘密情報・本文を含まない安全なログ */
function logSafe(event, detail) {
  console.log(JSON.stringify({ event, detail: detail ?? null }));
}

/** LINE WORKSの文字数上限に合わせて改行位置優先で分割 */
function splitText(text, limit) {
  const chunks = [];
  let rest = String(text);
  while (rest.length > limit) {
    let cut = rest.lastIndexOf("\n", limit);
    if (cut < limit * 0.5) cut = limit;
    chunks.push(rest.slice(0, cut).trim());
    rest = rest.slice(cut).trim();
  }
  if (rest) chunks.push(rest);
  return chunks;
}

// ==================================================================
// 4. LINE WORKS 認証（JWT → アクセストークン）
// ==================================================================

function tokenCacheKey(env) {
  return `sys:lw_token:${env.LINEWORKS_CLIENT_ID}`;
}

async function createJWT(env) {
  const now = Math.floor(Date.now() / 1000);
  const header = { alg: "RS256", typ: "JWT" };
  const claims = {
    iss: env.LINEWORKS_CLIENT_ID,
    sub: env.LINEWORKS_SERVICE_ACCOUNT,
    iat: now,
    exp: now + 3600,
  };
  const signingInput = `${b64url(JSON.stringify(header))}.${b64url(JSON.stringify(claims))}`;

  const key = await crypto.subtle.importKey(
    "pkcs8",
    pemToArrayBuffer(env.LINEWORKS_PRIVATE_KEY),
    { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" },
    false,
    ["sign"]
  );
  const sig = await crypto.subtle.sign(
    "RSASSA-PKCS1-v1_5",
    key,
    new TextEncoder().encode(signingInput)
  );
  return `${signingInput}.${b64url(sig)}`;
}

async function getAccessToken(env) {
  const cacheKey = tokenCacheKey(env);
  try {
    const cached = await env.BOT_KV.get(cacheKey, "json");
    if (cached && cached.exp > Math.floor(Date.now() / 1000) + 300) return cached.token;
  } catch (_) {
    /* 読み失敗は無視して再取得 */
  }

  const body = new URLSearchParams({
    assertion: await createJWT(env),
    grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer",
    client_id: env.LINEWORKS_CLIENT_ID,
    client_secret: env.LINEWORKS_CLIENT_SECRET,
    scope: "bot",
  });

  const res = await fetch(LW_AUTH_URL, {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: body.toString(),
  });
  if (!res.ok) {
    logSafe("lw_token_failed", { status: res.status });
    throw new Error(`LINEWORKS token error: ${res.status}`);
  }

  const data = await res.json();
  const expiresIn = Number(data.expires_in) || 86400;
  try {
    await env.BOT_KV.put(
      cacheKey,
      JSON.stringify({ token: data.access_token, exp: Math.floor(Date.now() / 1000) + expiresIn }),
      { expirationTtl: Math.max(60, expiresIn - 60) }
    );
  } catch (_) {
    /* 書き失敗は無視 */
  }
  return data.access_token;
}

// ==================================================================
// 5. LINE WORKS 送信
//    target = { userId, channelId }  channelIdがあればトークルームへ送信
// ==================================================================

// quickReply非対応環境で400が返った場合、以後このisolateでは付けない
let quickReplyEnabled = true;

function messageUrl(env, target) {
  const base = `${LW_API_BASE}/bots/${encodeURIComponent(env.LINEWORKS_BOT_ID)}`;
  return target.channelId
    ? `${base}/channels/${encodeURIComponent(target.channelId)}/messages`
    : `${base}/users/${encodeURIComponent(target.userId)}/messages`;
}

async function postMessage(env, target, content) {
  const doPost = (token) =>
    fetch(messageUrl(env, target), {
      method: "POST",
      headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
      body: JSON.stringify({ content }),
    });

  try {
    let res = await doPost(await getAccessToken(env));
    if (res.status === 401) {
      await env.BOT_KV.delete(tokenCacheKey(env)).catch(() => {});
      res = await doPost(await getAccessToken(env));
    }
    if (!res.ok) logSafe("lw_send_failed", { status: res.status, type: content.type });
    return { ok: res.ok, status: res.status };
  } catch (e) {
    logSafe("lw_send_exception", { name: e && e.name });
    return { ok: false, status: 0 };
  }
}

function quickReply() {
  return {
    items: [
      { action: { type: "message", label: "メニュー", text: "メニュー" } },
      { action: { type: "message", label: "リセット", text: "リセット" } },
      { action: { type: "message", label: "ヘルプ", text: "ヘルプ" } },
    ],
  };
}

/** テキスト送信（長文は分割、最後の吹き出しにクイックリプライ） */
async function sendText(env, target, text, { quick = false } = {}) {
  const chunks = splitText(text, LW_TEXT_LIMIT);
  let allOk = true;

  for (let i = 0; i < chunks.length; i++) {
    const isLast = i === chunks.length - 1;
    const content = { type: "text", text: chunks[i] };
    const withQuick = quick && isLast && quickReplyEnabled;
    if (withQuick) content.quickReply = quickReply();

    let r = await postMessage(env, target, content);
    if (!r.ok && r.status === 400 && withQuick) {
      quickReplyEnabled = false;
      delete content.quickReply;
      r = await postMessage(env, target, content);
    }
    if (!r.ok) allOk = false;
  }
  return allOk;
}

