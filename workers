async function sendSelector(env, target, currentId) {
  const r = await postMessage(env, target, buildSelectorFlex(currentId));
  if (!r.ok) {
    // FLEXが通らない場合もユーザーを無言にしない
    logSafe("flex_fallback", { status: r.status });
    await sendText(env, target, buildTextMenu());
  }
}

function buildHelp(env) {
  const turns = historyTurns(env);
  return (
    "📖 使い方\n\n" +
    "・メニュー … アシスタントの選択画面に戻る\n" +
    "・リセット … 今のアシスタントとの会話を消して選択画面に戻る\n" +
    "・全部リセット … すべてのアシスタントとの会話を消す\n" +
    "・現在のアシスタント … 選択中のアシスタントを表示\n" +
    "・ヘルプ … この説明を表示\n\n" +
    `アシスタントごとに直近${turns}往復の会話を覚えています。\n` +
    "（メニューで戻っても会話は残ります）\n\n" +
    "⚠️ ご利用上の注意\n\n" +
    "・回答はAIが自動で作成したものです。誤りを含む可能性があるため、あくまで参考程度にご利用ください。\n" +
    "・診断・治療・服薬の判断はできません。必ず医師・薬剤師などの専門職にご確認ください。\n" +
    "・急に具合が悪くなったときは、このBotを使わず、すぐに医療機関を受診するか119番に連絡してください。\n" +
    "・氏名・患者IDなど、個人を特定できる情報は入力しないでください。"
  );
}

// ==================================================================
// 7. Webhook検証
// ==================================================================

async function verifySignature(env, rawBody, signature) {
  if (!signature) return false;
  try {
    const key = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(env.LINEWORKS_BOT_SECRET),
      { name: "HMAC", hash: "SHA-256" },
      false,
      ["sign"]
    );
    const mac = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(rawBody));
    return safeEqual(bytesToB64(mac), signature);
  } catch (e) {
    logSafe("sig_verify_exception", { name: e && e.name });
    return false;
  }
}

/** issuedTimeが5分以上ずれたイベントは処理しない（リプレイ緩和） */
function isFreshEvent(body) {
  if (!body.issuedTime) return true;
  const t = Date.parse(body.issuedTime);
  if (Number.isNaN(t)) return true;
  return Math.abs(Date.now() - t) < 5 * 60 * 1000;
}

// ==================================================================
// 8. KV（状態・履歴）
//    キー設計（Bot ID + スコープで分離。ユーザー間で混ざらない）
//      state:{botId}:{scope}            → { expert }
//      hist:{botId}:{scope}:{expertId}  → [{role, content}, ...]
//    scope = 1:1トーク   "u:{userId}"
//            グループ内  "c:{channelId}:u:{userId}"
// ==================================================================

function scopeOf(target) {
  return target.channelId
    ? `c:${target.channelId}:u:${target.userId}`
    : `u:${target.userId}`;
}

function stateKey(env, scope) {
  return `state:${env.LINEWORKS_BOT_ID}:${scope}`;
}

function histKey(env, scope, expertId) {
  return `hist:${env.LINEWORKS_BOT_ID}:${scope}:${expertId}`;
}

function historyTtl(env) {
  return intEnv(env.HISTORY_TTL_DAYS, DEFAULT_HISTORY_TTL_DAYS, 1, 365) * 86400;
}

function historyTurns(env) {
  return intEnv(env.HISTORY_TURNS, DEFAULT_HISTORY_TURNS, 1, 50);
}

async function loadState(env, scope) {
  try {
    const s = await env.BOT_KV.get(stateKey(env, scope), "json");
    if (s && EXPERT_BY_ID[s.expert]) return s;
  } catch (_) {
    /* 壊れていたら未選択扱い */
  }
  return { expert: null };
}

async function saveState(env, scope, state) {
  try {
    await env.BOT_KV.put(stateKey(env, scope), JSON.stringify(state), {
      expirationTtl: STATE_TTL,
    });
  } catch (e) {
    logSafe("kv_state_put_failed", { name: e && e.name });
  }
}

async function loadHistory(env, scope, expertId) {
  try {
    const h = await env.BOT_KV.get(histKey(env, scope, expertId), "json");
    if (Array.isArray(h)) {
      return h.filter(
        (m) =>
          m &&
          (m.role === "user" || m.role === "assistant") &&
          typeof m.content === "string"
      );
    }
  } catch (_) {
    /* 壊れていたら空 */
  }
  return [];
}

async function saveHistory(env, scope, expertId, messages) {
  try {
    await env.BOT_KV.put(histKey(env, scope, expertId), JSON.stringify(messages), {
      expirationTtl: historyTtl(env),
    });
  } catch (e) {
    logSafe("kv_hist_put_failed", { name: e && e.name });
  }
}

async function deleteHistory(env, scope, expertId) {
  await env.BOT_KV.delete(histKey(env, scope, expertId)).catch(() => {});
}

async function deleteAllHistory(env, scope) {
  await Promise.all(EXPERTS.map((e) => deleteHistory(env, scope, e.id)));
}

/** 直近N往復＋文字数上限で切り詰め。先頭は必ずuserにする */
function trimHistory(messages, turns) {
  let out = messages.slice(-turns * 2);
  let total = out.reduce((n, m) => n + m.content.length, 0);
  while (out.length > 2 && total > MAX_HISTORY_CHARS) {
    total -= out[0].content.length;
    out = out.slice(1);
  }
  while (out.length && out[0].role !== "user") out = out.slice(1);
  return out;
}

// ==================================================================
// 9. プロンプト組み立て / OpenAI
// ==================================================================

function buildSystemPrompt(env, expert) {
  const base =
    envText(env[expert.promptEnv]) ||
    `私は「${expert.name}」です。${expert.desc}の分野で長年の経験を持つ専門職として、質問に分かりやすく答えます。`;

  const parts = [base];
  if (expert.medical) parts.push(envText(env.PROMPT_COMMON_MEDICAL) || DEFAULT_COMMON_MEDICAL);
  parts.push(envText(env.PROMPT_COMMON) || DEFAULT_COMMON);
  return parts.join("\n\n");
}

async function askOpenAI(env, expert, history, userText) {
  const model = env.OPENAI_MODEL || DEFAULT_MODEL;
  // gpt-5系・oシリーズ(推論モデル)は temperature 非対応のため付けない
  const isReasoning = /^(gpt-5|o\d)/i.test(model);

  const payload = {
    model,
    messages: [
      { role: "system", content: buildSystemPrompt(env, expert) },
      ...history,
      { role: "user", content: userText },
    ],
  };
  if (isReasoning) {
    payload.max_completion_tokens = 4000; // 推論トークン込み
  } else {
    payload.max_completion_tokens = 1200;
    payload.temperature = 0.4;
  }

  let res;
  try {
    res = await fetch(OPENAI_URL, {
      method: "POST",
      headers: {
        Authorization: `Bearer ${env.OPENAI_API_KEY}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
      signal: AbortSignal.timeout(OPENAI_TIMEOUT_MS),
    });
  } catch (e) {
    logSafe("openai_fetch_failed", { name: e && e.name }); // TimeoutError含む
    return null;
  }

  if (!res.ok) {
    logSafe("openai_http_error", { status: res.status }); // 401/429/5xx
    return null;
  }

  let data;
  try {
    data = await res.json();
  } catch (e) {
    logSafe("openai_json_error", { name: e && e.name });
    return null;
  }

  const text = data?.choices?.[0]?.message?.content;
  if (typeof text !== "string" || !text.trim()) {
    logSafe("openai_empty_response", { finish: data?.choices?.[0]?.finish_reason ?? null });
    return null;
  }
  return text.trim();
}

// ==================================================================
// 10. アシスタント判定
// ==================================================================

function matchExpertByText(norm) {
  if (/^[0-9]+$/.test(norm)) {
    const idx = parseInt(norm, 10) - 1;
    return EXPERTS[idx] || null;
  }
  for (const e of EXPERTS) {
    const cands = [e.id, e.name, label(e), ...(e.aliases || [])].map(normalize);
    if (cands.includes(norm)) return e;
  }
  return null;
}

function matchExpertByPostback(pb) {
  if (typeof pb !== "string" || !pb.startsWith("select:")) return null;
  return EXPERT_BY_ID[pb.slice(7)] || null;
}

function isCommand(list, norm) {
  return list.map(normalize).includes(norm);
}

// ==================================================================
// 11. イベント処理
// ==================================================================

async function selectExpert(env, target, scope, state, expert) {
  if (state.expert !== expert.id) {
    state.expert = expert.id;
    await saveState(env, scope, state);
  }
  const history = await loadHistory(env, scope, expert.id);
  const turns = Math.floor(history.length / 2);
  const memo = turns > 0
    ? `\n\n（前回の会話 ${turns}往復分を覚えています。「リセット」で消去できます）`
    : "";
  await sendText(env, target, `${label(expert)}\n\n${expert.greeting}${memo}`, { quick: true });
}

/** 選択を解除してキャラ選択画面へ */
async function backToSelector(env, target, scope, state) {
  if (state.expert) {
    state.expert = null;
    await saveState(env, scope, state);
  }
  await sendSelector(env, target, null);
}

async function handleEvent(env, body) {
  const src = body.source || {};

  // Botがトークルームに招待された
  if ((body.type === "join" || body.type === "joined") && src.channelId) {
    await sendSelector(env, { userId: null, channelId: src.channelId }, null);
    return;
  }

  if (!src.userId) return;

  const target = { userId: src.userId, channelId: src.channelId || null };
  const scope = scopeOf(target);
  const state = await loadState(env, scope);

  // ---- postbackイベント ----
  if (body.type === "postback") {
    const ex = matchExpertByPostback(body.data);
    if (ex) return selectExpert(env, target, scope, state, ex);
    return sendSelector(env, target, state.expert);
  }

  if (body.type !== "message") return; // leave等は無視

  const content = body.content || {};

  // ---- ボタン由来のpostback付きメッセージ ----
  const pbExpert = matchExpertByPostback(content.postback);
  if (pbExpert) return selectExpert(env, target, scope, state, pbExpert);

  // ---- テキスト以外 ----
  if (content.type !== "text") {
    if (!state.expert) return sendSelector(env, target, null);
    return sendText(env, target, MSG.unsupported, { quick: true });
  }

  const rawText = String(content.text || "").trim();
  if (!rawText) return;
  if (rawText.length > MAX_INPUT_CHARS) {
    return sendText(env, target, MSG.tooLong, { quick: true });
  }

  const norm = normalize(rawText);

  // ---- コマンド: ヘルプ ----
  if (isCommand(CMD_HELP, norm)) {
    return sendText(env, target, buildHelp(env), { quick: true });
  }

  // ---- コマンド: メニュー（選択解除 → キャラ選択画面。履歴は残す） ----
  if (isCommand(CMD_MENU, norm)) {
    return backToSelector(env, target, scope, state);
  }

  // ---- コマンド: 全部リセット（全履歴削除 → キャラ選択画面） ----
  if (isCommand(CMD_RESET_ALL, norm)) {
    await deleteAllHistory(env, scope);
    await sendText(env, target, "🗑️ すべてのアシスタントとの会話履歴を削除しました。");
    return backToSelector(env, target, scope, state);
  }

  // ---- コマンド: リセット（今のアシスタントの履歴削除 → キャラ選択画面） ----
  if (isCommand(CMD_RESET, norm)) {
    if (state.expert) {
      const prev = EXPERT_BY_ID[state.expert];
      await deleteHistory(env, scope, prev.id);
      await sendText(env, target, `${label(prev)}との会話履歴を削除しました。`);
    }
    return backToSelector(env, target, scope, state);
  }

  // ---- 名前・番号での切り替え ----
  const textExpert = matchExpertByText(norm);
  if (textExpert) return selectExpert(env, target, scope, state, textExpert);

  // ---- 未選択なら、何を送ってもキャラ選択FLEX ----
  if (!state.expert) return sendSelector(env, target, null);

  const expert = EXPERT_BY_ID[state.expert];

  // ---- コマンド: 現在のアシスタント ----
  if (isCommand(CMD_STATUS, norm)) {
    const h = await loadHistory(env, scope, expert.id);
    return sendText(
      env,
      target,
      `現在のアシスタント: ${label(expert)}\n会話履歴: ${Math.floor(h.length / 2)}往復`,
      { quick: true }
    );
  }

  // ---- 通常会話 ----
  const history = await loadHistory(env, scope, expert.id);
  const answer = await askOpenAI(env, expert, history, rawText);

  if (!answer) {
    return sendText(env, target, MSG.aiError, { quick: true }); // 履歴は汚さない
  }

  const ok = await sendText(env, target, `${label(expert)}\n\n${answer}`, { quick: true });

  if (ok) {
    const next = trimHistory(
      [...history, { role: "user", content: rawText }, { role: "assistant", content: answer }],
      historyTurns(env)
    );
    await saveHistory(env, scope, expert.id, next);
  }
}

// ==================================================================
// 12. ヘルスチェック
// ==================================================================

const REQUIRED_ENV = [
  "OPENAI_API_KEY",
  "LINEWORKS_BOT_ID",
  "LINEWORKS_BOT_SECRET",
  "LINEWORKS_CLIENT_ID",
  "LINEWORKS_CLIENT_SECRET",
  "LINEWORKS_SERVICE_ACCOUNT",
  "LINEWORKS_PRIVATE_KEY",
];

function buildHealth(env) {
  const missingEnv = REQUIRED_ENV.filter((k) => !env[k]);
  const kvBound = !!env.BOT_KV;

  // プロンプト変数（共通＋個別）のサイズ確認
  const promptNames = [
    "PROMPT_COMMON",
    "PROMPT_COMMON_MEDICAL",
    ...EXPERTS.map((e) => e.promptEnv),
  ];
  const promptSizes = {};
  const missingPrompts = [];
  const promptWarnings = [];

  for (const name of promptNames) {
    const bytes = byteLength(env[name]);
    promptSizes[name] = `${bytes} / ${ENV_VAR_LIMIT_BYTES} bytes`;
    if (!envText(env[name])) missingPrompts.push(name);
    if (bytes > ENV_VAR_WARN_BYTES) promptWarnings.push(`${name} が上限に近い（${bytes} bytes）`);
  }

  return {
    status: missingEnv.length === 0 && kvBound ? "ok" : "misconfigured",
    missingEnv,
    kvBound,
    missingPrompts,   // 未設定でも既定文で動く（警告扱い）
    promptWarnings,
    promptSizes,
    model: env.OPENAI_MODEL || DEFAULT_MODEL,
    historyTurns: historyTurns(env),
    assistants: EXPERTS.map((e) => label(e)),
  };
}

// ==================================================================
// 13. エントリポイント
// ==================================================================

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // ヘルスチェック（値そのものは返さない）
    if (request.method === "GET" && url.pathname === "/") {
      return new Response(JSON.stringify(buildHealth(env), null, 2), {
        headers: { "Content-Type": "application/json; charset=utf-8" },
      });
    }

    if (request.method !== "POST" || url.pathname !== "/callback") {
      return new Response("Not Found", { status: 404 });
    }

    const rawBody = await request.text();

    const valid = await verifySignature(env, rawBody, request.headers.get("X-WORKS-Signature"));
    if (!valid) {
      logSafe("invalid_signature", null);
      return new Response("Unauthorized", { status: 401 });
    }

    // 別Botからの誤配送を防ぐ
    const botIdHeader = request.headers.get("X-WORKS-BotId");
    if (botIdHeader && String(botIdHeader) !== String(env.LINEWORKS_BOT_ID)) {
      logSafe("bot_id_mismatch", null);
      return new Response("Forbidden", { status: 403 });
    }

    let body;
    try {
      body = JSON.parse(rawBody);
    } catch (_) {
      return new Response("Bad Request", { status: 400 });
    }

    if (!isFreshEvent(body)) {
      logSafe("stale_event_rejected", null);
      return new Response("OK", { status: 200 });
    }

    // 先に200を返し、OpenAI呼び出しは裏で実行（Webhookの再送防止）
    ctx.waitUntil(
      handleEvent(env, body).catch((e) => logSafe("handler_exception", { name: e && e.name }))
    );
    return new Response("OK", { status: 200 });
  },
};
